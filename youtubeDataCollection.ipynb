   "source": [
    "# CELL — Annotation interface (proper version)\n",
    "# Faster than before — keyboard-driven\n",
    "# Shows context, category, EPH signals clearly\n",
    "\n",
    "import pandas as pd\n",
    "import os\n",
    "\n",
    "batch_path  = './BanglishDetect/data/raw/annotation_batch_final.csv'\n",
    "ann_path    = './BanglishDetect/data/raw/youtube_clean_full.csv'\n",
    "\n",
    "df_batch = pd.read_csv(batch_path)\n",
    "\n",
    "# Load existing annotations\n",
    "if os.path.exists(ann_path):\n",
    "    df_done    = pd.read_csv(ann_path)\n",
    "    done_texts = set(df_done['text'].tolist())\n",
    "    df_todo    = df_batch[\n",
    "        ~df_batch['text'].isin(done_texts)\n",
    "    ].reset_index(drop=True)\n",
    "    ANNOTATIONS = df_done.to_dict('records')\n",
    "else:\n",
    "    ANNOTATIONS = []\n",
    "    done_texts  = set()\n",
    "    df_todo     = df_batch.copy()\n",
    "\n",
    "print(f\"Total batch:      {len(df_batch):,}\")\n",
    "print(f\"Already done:     {len(done_texts):,}\")\n",
    "print(f\"Remaining:        {len(df_todo):,}\")\n",
    "print()\n",
    "print(\"HOW TO ANNOTATE:\")\n",
    "print(\"  annotate(1)    → Depressive\")\n",
    "print(\"  annotate(0)    → Non-Depressive\")\n",
    "print(\"  skip_comment() → Skip unclear\")\n",
    "print(\"  show_stats()   → Show progress\")\n",
    "print(\"  save_ann()     → Save progress\")\n",
    "\n",
    "current = [0]\n",
    "\n",
    "def save_ann():\n",
    "    df_ann = pd.DataFrame(ANNOTATIONS)\n",
    "    df_ann.to_csv(ann_path, index=False)\n",
    "    print(f\"✅ Saved {len(ANNOTATIONS)} annotations\")\n",
    "\n",
    "def show_stats():\n",
    "    dep     = sum(1 for a in ANNOTATIONS if a['label']==1)\n",
    "    non_dep = sum(1 for a in ANNOTATIONS if a['label']==0)\n",
    "    print(f\"\\nProgress: {len(ANNOTATIONS)}/{len(df_batch)}\")\n",
    "    print(f\"  Depressive:     {dep}\")\n",
    "    print(f\"  Non-Depressive: {non_dep}\")\n",
    "    print(f\"  Remaining:      {len(df_todo)-current[0]}\")\n",
    "\n",
    "def show_next():\n",
    "    \"\"\"Display next comment for annotation\"\"\"\n",
    "    idx = current[0]\n",
    "    if idx >= len(df_todo):\n",
    "        print(\"✅ All comments annotated!\")\n",
    "        save_ann()\n",
    "        return\n",
    "\n",
    "    row = df_todo.iloc[idx]\n",
    "    text     = str(row['text'])\n",
    "    cat      = row.get('category','unknown')\n",
    "    score    = row.get('eph_score_v2', 0)\n",
    "    tentative= row.get('tentative_label', '?')\n",
    "    words    = row.get('word_count', 0)\n",
    "\n",
    "    # Detect signals\n",
    "    has_em  = any(em in text for em in EMOTICONS)\n",
    "    has_bn  = bool(re.search(r'[a-zA-Z]',text) and\n",
    "                   re.search(r'[\\u0980-\\u09FF]',text))\n",
    "    has_el  = bool(re.search(r'(.)\\1{2,}', text))\n",
    "    has_neg = any(w in text for w in NEGATION)\n",
    "\n",
    "    signals = []\n",
    "    if has_em:  signals.append(\"😭emoticon\")\n",
    "    if has_bn:  signals.append(\"🔀banglish\")\n",
    "    if has_el:  signals.append(\"📢elongation\")\n",
    "    if has_neg: signals.append(\"❌negation\")\n",
    "\n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"#{idx+1}/{len(df_todo)} | \"\n",
    "          f\"Category: {cat} | \"\n",
    "          f\"EPH score: {score} | \"\n",
    "          f\"Words: {words}\")\n",
    "    print(f\"Tentative label: \"\n",
    "          f\"{'DEPRESSIVE' if tentative==1 else 'NON-DEPRESSIVE'}\")\n",
    "    if signals:\n",
    "        print(f\"EPH signals: {' | '.join(signals)}\")\n",
    "    print(f\"\\n📝 TEXT:\\n{text}\")\n",
    "    print(f\"\\n{'─'*60}\")\n",
    "    print(\"[1]=Depressive  [0]=Non-Dep  [s]=Skip  [?]=Unsure\")\n",
    "\n",
    "def annotate(label):\n",
    "    \"\"\"Label current comment and move to next\"\"\"\n",
    "    idx = current[0]\n",
    "    if idx >= len(df_todo):\n",
    "        print(\"No more comments to annotate\")\n",
    "        return\n",
    "\n",
    "    row  = df_todo.iloc[idx].copy()\n",
    "    text = str(row['text'])\n",
    "\n",
    "    if text not in done_texts:\n",
    "        ANNOTATIONS.append({\n",
    "            'text':      text,\n",
    "            'label':     int(label),\n",
    "            'category':  row.get('category',''),\n",
    "            'eph_score': row.get('eph_score_v2', 0),\n",
    "            'annotated_label': label,\n",
    "            'tentative_label': row.get('tentative_label', -1),\n",
    "        })\n",
    "        done_texts.add(text)\n",
    "\n",
    "    current[0] += 1\n",
    "\n",
    "    # Auto-save every 50\n",
    "    if len(ANNOTATIONS) % 50 == 0:\n",
    "        save_ann()\n",
    "        print(f\"  [Auto-saved at {len(ANNOTATIONS)} annotations]\")\n",
    "\n",
    "    show_next()\n",
    "\n",
    "def skip_comment():\n",
    "    \"\"\"Skip unclear comment\"\"\"\n",
    "    current[0] += 1\n",
    "    show_next()\n",
    "\n",
    "# Start\n",
    "show_next()"
   ]
