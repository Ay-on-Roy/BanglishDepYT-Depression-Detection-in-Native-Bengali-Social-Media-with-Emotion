    "\n",
    "    category_stats[f\"non::{cat}\"] = {\n",
    "\n",
    "        'queries': len(qlist),\n",
    "        'videos': 0,\n",
    "        'comments': 0\n",
    "\n",
    "    }\n",
    "\n",
    "# ============================================================\n",
    "# SEARCH VIDEOS\n",
    "# ============================================================\n",
    "\n",
    "def search_videos(query, max_results=5):\n",
    "\n",
    "    for attempt in range(3):\n",
    "\n",
    "        try:\n",
    "\n",
    "            res = youtube.search().list(\n",
    "                part=\"snippet\",\n",
    "                q=query,\n",
    "                type=\"video\",\n",
    "                relevanceLanguage=\"bn\",\n",
    "                maxResults=max_results,\n",
    "                videoDuration=\"medium\",\n",
    "                order=\"relevance\"\n",
    "            ).execute()\n",
    "\n",
    "            return [\n",
    "                item['id']['videoId']\n",
    "                for item in res.get('items', [])\n",
    "            ]\n",
    "\n",
    "        except Exception as e:\n",
    "\n",
    "            print(f\"Search retry {attempt+1}: {e}\")\n",
    "\n",
    "            time.sleep(\n",
    "                2 * (attempt + 1)\n",
    "            )\n",
    "\n",
    "    return []\n",
    "\n",
    "# ============================================================\n",
    "# GET VIDEO METADATA\n",
    "# ============================================================\n",
    "\n",
    "def get_video_metadata(video_id):\n",
    "\n",
    "    try:\n",
    "\n",
    "        res = youtube.videos().list(\n",
    "            part=\"snippet,statistics\",\n",
    "            id=video_id\n",
    "        ).execute()\n",
    "\n",
    "        if not res.get('items'):\n",
    "            return {}\n",
    "\n",
    "        item = res['items'][0]\n",
    "\n",
    "        return {\n",
    "\n",
    "            'title':\n",
    "                item['snippet'].get('title', ''),\n",
    "\n",
    "            'channel':\n",
    "                item['snippet'].get('channelTitle', ''),\n",
    "\n",
    "            'published_at':\n",
    "                item['snippet'].get('publishedAt', ''),\n",
    "\n",
    "            'views':\n",
    "                item['statistics'].get('viewCount', 0),\n",
    "\n",
    "            'comments_count':\n",
    "                item['statistics'].get('commentCount', 0),\n",
    "\n",
    "        }\n",
    "\n",
    "    except Exception:\n",
    "\n",
    "        return {}\n",
    "\n",
    "# ============================================================\n",
    "# GET TRANSCRIPT\n",
    "# ============================================================\n",
    "\n",
    "def get_transcript(video_id):\n",
    "\n",
    "    try:\n",
    "\n",
    "        transcript = YouTubeTranscriptApi.get_transcript(\n",
    "            video_id,\n",
    "            languages=['bn', 'en']\n",
    "        )\n",
    "\n",
    "        formatter = TextFormatter()\n",
    "\n",
    "        transcript_text = formatter.format_transcript(\n",
    "            transcript\n",
    "        )\n",
    "\n",
    "        return transcript_text\n",
    "\n",
    "    except Exception:\n",
    "\n",
    "        return \"\"\n",
    "\n",
    "# ============================================================\n",
    "# GET COMMENTS\n",
    "# ============================================================\n",
    "\n",
    "def get_comments(video_id, max_per_video=200):\n",
    "\n",
    "    comments = []\n",
    "\n",
    "    page_token = None\n",
    "\n",
    "    try:\n",
    "\n",
    "        while len(comments) < max_per_video:\n",
    "\n",
    "            res = youtube.commentThreads().list(\n",
    "                part=\"snippet\",\n",
    "                videoId=video_id,\n",
    "                maxResults=100,\n",
    "                pageToken=page_token,\n",
    "                textFormat=\"plainText\",\n",
    "                order=\"relevance\"\n",
    "            ).execute()\n",
    "\n",
    "            for item in res.get('items', []):\n",
    "\n",
    "                snippet = item['snippet']['topLevelComment']['snippet']\n",
    "\n",
    "                comments.append({\n",
    "\n",
    "                    'text':\n",
    "                        snippet.get('textDisplay', ''),\n",
    "\n",
    "                    'likes':\n",
    "                        snippet.get('likeCount', 0),\n",
    "\n",
    "                    'published_at':\n",
    "                        snippet.get('publishedAt', ''),\n",
    "\n",
    "                    'reply_count':\n",
    "                        item['snippet'].get(\n",
    "                            'totalReplyCount',\n",
    "                            0\n",
    "                        ),\n",
    "\n",
    "                    'author_channel':\n",
    "                        snippet.get(\n",
    "                            'authorChannelId',\n",
    "                            {}\n",
    "                        ).get('value', '')\n",
    "\n",
    "                })\n",
    "\n",
    "                if len(comments) >= max_per_video:\n",
    "                    break\n",
    "\n",
    "            page_token = res.get('nextPageToken')\n",
    "\n",
    "            if not page_token:\n",
    "                break\n",
    "\n",
    "    except Exception:\n",
    "        pass\n",
    "\n",
    "    return comments\n",
    "\n",
    "# ============================================================\n",
    "# BENGALI DETECTION\n",
    "# ============================================================\n",
    "\n",
    "def is_bengali(text, min_chars=5):\n",
    "\n",
    "    text = str(text)\n",
    "\n",
    "    bn_chars = len(\n",
    "        re.findall(r'[\\u0980-\\u09FF]', text)\n",
    "    )\n",
    "\n",
    "    if bn_chars >= min_chars:\n",
    "        return True\n",
    "\n",
    "    try:\n",
    "\n",
    "        lang = detect(text)\n",
    "\n",
    "        if lang == 'bn':\n",
    "            return True\n",
    "\n",
    "    except:\n",
    "        pass\n",
    "\n",
    "    return False\n",
    "\n",
    "# ============================================================\n",
    "# BANGLISH DETECTOR\n",
    "# ============================================================\n",
    "\n",
    "def is_banglish(text):\n",
    "\n",
    "    text = str(text)\n",
    "\n",
    "    has_english = bool(\n",
    "        re.search(r'[a-zA-Z]', text)\n",
    "    )\n",
    "\n",
    "    has_bn = bool(\n",
    "        re.search(r'[\\u0980-\\u09FF]', text)\n",
    "    )\n",
    "\n",
    "    return has_english and has_bn\n",
    "\n",
    "# ============================================================\n",
    "# QUALITY FILTER\n",
    "# ============================================================\n",
    "\n",
    "def is_meaningful(text, min_words=3):\n",
    "\n",
    "    text = str(text).strip()\n",
    "\n",
    "    if len(text) < 10:\n",
    "        return False\n",
    "\n",
    "    words = text.split()\n",
    "\n",
    "    if len(words) < min_words:\n",
    "        return False\n",
    "\n",
    "    # Emoji-only\n",
    "\n",
    "    if re.match(\n",
    "        r'^[\\U0001F600-\\U0001FFFF\\s]+$',\n",
    "        text\n",
    "    ):\n",
    "        return False\n",
    "\n",
    "    # Repeated spam\n",
    "\n",
    "    if re.search(r'(.)\\1{6,}', text):\n",
    "        return False\n",
    "\n",
    "    return True\n",
    "\n",
    "# ============================================================\n",
    "# CRASH SAFE SAVE\n",
    "# ============================================================\n",
    "\n",
    "def save_checkpoint(data):\n",
    "\n",
    "    temp_path = RAW_PATH + \".tmp\"\n",
    "\n",
    "    pd.DataFrame(data).to_csv(\n",
    "        temp_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    os.replace(\n",
    "        temp_path,\n",
    "        RAW_PATH\n",
    "    )\n",
    "# ============================================================\n",
    "# SAVE QUERY PROGRESS\n",
    "# ============================================================\n",
    "\n",
    "def save_query_progress(query):\n",
    "\n",
    "    global completed_queries\n",
    "\n",
    "    completed_queries.add(query)\n",
    "\n",
    "    pd.DataFrame({\n",
    "\n",
    "        'query': list(completed_queries)\n",
    "\n",
    "    }).to_csv(\n",
    "\n",
    "        PROGRESS_PATH,\n",
    "\n",
    "        index=False\n",
    "\n",
    "    )\n",
    "\n",
    "# ============================================================\n",
    "# SAVE QUERY-VIDEO PROGRESS\n",
    "# ============================================================\n",
    "\n",
    "def save_query_video_progress(query, video_id):\n",
    "\n",
    "    global processed_query_videos\n",
    "\n",
    "    processed_query_videos.add(\n",
    "\n",
    "        (query, video_id)\n",
    "\n",
    "    )\n",
    "\n",
    "    rows = [\n",
    "\n",
    "        {\n",
    "\n",
    "            'query': q,\n",
    "\n",
    "            'video_id': v\n",
    "\n",
    "        }\n",
    "\n",
    "        for q, v in processed_query_videos\n",
    "\n",
    "    ]\n",
    "\n",
    "    pd.DataFrame(rows).to_csv(\n",
    "\n",
    "        VIDEO_QUERY_PATH,\n",
    "\n",
    "        index=False\n",
    "\n",
    "    )\n",
    "# ============================================================\n",
    "# RESUME SUPPORT\n",
    "# ============================================================\n",
    "\n",
    "if os.path.exists(RAW_PATH):\n",
    "\n",
    "    existing_df = pd.read_csv(RAW_PATH)\n",
    "\n",
    "    all_comments = existing_df.to_dict(\n",
    "        'records'\n",
    "    )\n",
    "\n",
    "    seen_texts = set(\n",
    "        existing_df['text']\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "    seen_video_ids = set(\n",
    "        existing_df['video_id']\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "    print(\"=\" * 60)\n",
    "    print(\"RESUMING EXISTING COLLECTION\")\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "    print(\n",
    "        f\"Loaded comments: \"\n",
    "        f\"{len(all_comments):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"Known videos: \"\n",
    "        f\"{len(seen_video_ids):,}\"\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    all_comments = []\n",
    "\n",
    "    seen_texts = set()\n",
    "\n",
    "    seen_video_ids = set()\n",
    "\n",
    "    print(\"=\" * 60)\n",
    "    print(\"STARTING FRESH COLLECTION\")\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "# ============================================================\n",
    "# LOAD QUERY PROGRESS\n",
    "# ============================================================\n",
    "\n",
    "if os.path.exists(PROGRESS_PATH):\n",
    "\n",
    "    progress_df = pd.read_csv(PROGRESS_PATH)\n",
    "\n",
    "    completed_queries = set(\n",
    "\n",
    "        progress_df['query'].astype(str)\n",
    "\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    completed_queries = set()\n",
    "\n",
    "# ============================================================\n",
    "# LOAD QUERY-VIDEO PROGRESS\n",
    "# ============================================================\n",
    "\n",
    "if os.path.exists(VIDEO_QUERY_PATH):\n",
    "\n",
    "    qv_df = pd.read_csv(VIDEO_QUERY_PATH)\n",
    "\n",
    "    processed_query_videos = set(\n",
    "\n",
    "        zip(\n",
    "\n",
    "            qv_df['query'].astype(str),\n",
    "\n",
    "            qv_df['video_id'].astype(str)\n",
    "\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    processed_query_videos = set()\n",
    "# ============================================================\n",
    "# API TRACKING\n",
    "# ============================================================\n",
    "\n",
    "api_units_used = 0\n",
    "\n",
    "# ============================================================\n",
    "# MASTER COLLECTION FUNCTION\n",
    "# ============================================================\n",
    "\n",
    "def collect_from_queries(\n",
    "    query_dict,\n",
    "    tentative_label,\n",
    "    label_name,\n",
    "    max_videos_per_query=3,\n",
    "    max_comments_per_video=200,\n",
    "    balance_queries=True,\n",
    "    max_queries_per_category=25\n",
    "):\n",
    "\n",
    "    global api_units_used\n",
    "    global all_comments\n",
    "    global seen_texts\n",
    "    global seen_video_ids\n",
    "    global category_stats\n",
    "\n",
    "    total_queries = sum(\n",
    "        len(v)\n",
    "        for v in query_dict.values()\n",
    "    )\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "\n",
    "    print(\n",
    "        f\"STARTING: \"\n",
    "        f\"{label_name.upper()}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"Categories: \"\n",
    "        f\"{len(query_dict)}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"Queries: \"\n",
    "        f\"{total_queries}\"\n",
    "    )\n",
    "\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "    for category, queries in query_dict.items():\n",
    "\n",
    "        category_key = (\n",
    "\n",
    "            f\"dep::{category}\"\n",
    "\n",
    "            if tentative_label == 1\n",
    "\n",
    "            else f\"non::{category}\"\n",
    "\n",
    "        )\n",
    "\n",
    "        print(\"\\n\" + \"-\" * 60)\n",
    "\n",
    "        print(f\"CATEGORY: {category}\")\n",
    "\n",
    "        print(\n",
    "            f\"Queries: {len(queries)}\"\n",
    "        )\n",
    "\n",
    "        print(\"-\" * 60)\n",
    "\n",
    "        # ====================================================\n",
    "        # BALANCE LARGE CATEGORIES\n",
    "        # ====================================================\n",
    "\n",
    "        if balance_queries:\n",
    "\n",
    "            if len(queries) > max_queries_per_category:\n",
    "\n",
    "                queries = random.sample(\n",
    "\n",
    "                    queries,\n",
    "\n",
    "                    max_queries_per_category\n",
    "\n",
    "                )\n",
    "\n",
    "        random.shuffle(queries)\n",
    "\n",
    "        # ====================================================\n",
    "        # PROCESS QUERIES\n",
    "        # ====================================================\n",
    "\n",
    "        for query in queries:\n",
    "            # =================================================\n",
    "            # SKIP COMPLETED QUERY\n",
    "            # =================================================\n",
    "            \n",
    "            if query in completed_queries:\n",
    "            \n",
    "                print(f\"⏭ Skipping completed query: {query}\")\n",
    "            \n",
    "                continue\n",
    "\n",
    "            if api_units_used >= MAX_UNITS:\n",
    "\n",
    "                print(\"\\n⚠️ API limit reached.\")\n",
    "                return\n",
    "\n",
    "            if len(all_comments) >= MAX_ROWS:\n",
    "\n",
    "                print(\"\\n⚠️ MAX_ROWS reached.\")\n",
    "                return\n",
    "\n",
    "            print(f\"\\n🔎 Searching: {query}\")\n",
    "\n",
    "            # =================================================\n",
    "            # SEARCH VIDEOS\n",
    "            # =================================================\n",
    "\n",
    "            video_ids = search_videos(\n",
    "                query,\n",
    "                max_results=5\n",
    "            )\n",
    "\n",
    "            api_units_used += SEARCH_COST\n",
    "\n",
    "            # =================================================\n",
    "            # REMOVE DUPLICATES\n",
    "            # =================================================\n",
    "\n",
    "            new_videos = [\n",
    "\n",
    "                v for v in video_ids\n",
    "            \n",
    "                if (\n",
    "                    v not in seen_video_ids\n",
    "                    and\n",
    "                    (query, v) not in processed_query_videos\n",
    "                )\n",
    "            \n",
    "            ]\n",
    "\n",
    "            if not new_videos:\n",
    "                continue\n",
    "\n",
    "            # =================================================\n",
    "            # PROCESS VIDEOS\n",
    "            # =================================================\n",
    "\n",
    "            for vid_id in tqdm(\n",
    "                new_videos[:max_videos_per_query]\n",
    "            ):\n",
    "\n",
    "                if api_units_used >= MAX_UNITS:\n",
    "                    return\n",
    "\n",
    "                seen_video_ids.add(vid_id)\n",
    "                save_query_video_progress(\n",
    "                    query,\n",
    "                    vid_id\n",
    "                )\n",
    "                category_stats[\n",
    "                    category_key\n",
    "                ]['videos'] += 1\n",
    "\n",
    "                # --------------------------------------------\n",
    "                # VIDEO META\n",
    "                # --------------------------------------------\n",
    "\n",
    "                meta = get_video_metadata(\n",
    "                    vid_id\n",
    "                )\n",
    "\n",
    "                api_units_used += VIDEO_META_COST\n",
    "\n",
    "                # --------------------------------------------\n",
    "                # TRANSCRIPT\n",
    "                # --------------------------------------------\n",
    "\n",
    "                transcript_text = get_transcript(\n",
    "                    vid_id\n",
    "                )\n",
    "\n",
    "                # --------------------------------------------\n",
    "                # COMMENTS\n",
    "                # --------------------------------------------\n",
    "\n",
    "                comments = get_comments(\n",
    "                    vid_id,\n",
    "                    max_per_video=max_comments_per_video\n",
    "                )\n",
    "\n",
    "                api_units_used += COMMENT_COST\n",
    "\n",
    "                # --------------------------------------------\n",
    "                # PROCESS COMMENTS\n",
    "                # --------------------------------------------\n",
    "\n",
    "                for c in comments:\n",
    "\n",
    "                    if len(all_comments) >= MAX_ROWS:\n",
    "\n",
    "                        print(\n",
    "                            \"\\n⚠️ MAX_ROWS reached.\"\n",
    "                        )\n",
    "\n",
    "                        return\n",
    "\n",
    "                    text = str(\n",
    "                        c['text']\n",
    "                    ).strip()\n",
    "\n",
    "                    # ----------------------------------------\n",
    "                    # FILTERS\n",
    "                    # ----------------------------------------\n",
    "\n",
    "                    if not is_bengali(text):\n",
    "                        continue\n",
    "\n",
    "                    if not is_meaningful(text):\n",
    "                        continue\n",
    "\n",
    "                    if text in seen_texts:\n",
    "                        continue\n",
    "\n",
    "                    seen_texts.add(text)\n",
    "\n",
    "                    category_stats[\n",
    "                        category_key\n",
    "                    ]['comments'] += 1\n",
    "\n",
    "                    # ----------------------------------------\n",
    "                    # SAVE RECORD\n",
    "                    # ----------------------------------------\n",
    "\n",
    "                    all_comments.append({\n",
    "\n",
    "                        # ====================\n",
    "                        # COMMENT\n",
    "                        # ====================\n",
    "\n",
    "                        'text':\n",
    "                            text,\n",
    "\n",
    "                        'likes':\n",
    "                            c['likes'],\n",
    "\n",
    "                        'published_at':\n",
    "                            c['published_at'],\n",
    "\n",
    "                        'reply_count':\n",
    "                            c['reply_count'],\n",
    "\n",
    "                        'author_channel':\n",
    "                            c['author_channel'],\n",
    "\n",
    "                        # ====================\n",
    "                        # VIDEO\n",
    "                        # ====================\n",
    "\n",
    "                        'video_id':\n",
    "                            vid_id,\n",
    "\n",
    "                        'title':\n",
    "                            meta.get(\n",
    "                                'title',\n",
    "                                ''\n",
    "                            ),\n",
    "\n",
    "                        'channel':\n",
    "                            meta.get(\n",
    "                                'channel',\n",
    "                                ''\n",
    "                            ),\n",
    "\n",
    "                        'video_views':\n",
    "                            meta.get(\n",
    "                                'views',\n",
    "                                0\n",
    "                            ),\n",
    "\n",
    "                        'video_comment_count':\n",
    "                            meta.get(\n",
    "                                'comments_count',\n",
    "                                0\n",
    "                            ),\n",
    "\n",
    "                        'video_published_at':\n",
    "                            meta.get(\n",
    "                                'published_at',\n",
    "                                ''\n",
    "                            ),\n",
    "\n",
    "                        # ====================\n",
    "                        # TRANSCRIPT\n",
    "                        # ====================\n",
    "\n",
    "                        'transcript':\n",
    "                            transcript_text[:5000],\n",
    "\n",
    "                        # ====================\n",
    "                        # LABELS\n",
    "                        # ====================\n",
    "\n",
    "                        'tentative_label':\n",
    "                            tentative_label,\n",
    "\n",
    "                        'label_source':\n",
    "                            label_name,\n",
    "\n",
    "                        'super_category':\n",
    "                            (\n",
    "                                'depressive'\n",
    "                                if tentative_label == 1\n",
    "                                else 'non_depressive'\n",
    "                            ),\n",
    "\n",
    "                        'category':\n",
    "                            category,\n",
    "\n",
    "                        'query':\n",
    "                            query,\n",
    "\n",
    "                        # ====================\n",
    "                        # FEATURES\n",
    "                        # ====================\n",
    "\n",
    "                        'is_banglish':\n",
    "                            is_banglish(text),\n",
    "\n",
    "                        'has_emoticon':\n",
    "                            any(\n",
    "                                em in text\n",
    "                                for em in EMOTICONS\n",
    "                            ),\n",
    "\n",
    "                        'text_length':\n",
    "                            len(text),\n",
    "\n",
    "                        'word_count':\n",
    "                            len(\n",
    "                                text.split()\n",
    "                            ),\n",
    "\n",
    "                    })\n",
    "\n",
    "                    # ----------------------------------------\n",
    "                    # CHECKPOINT\n",
    "                    # ----------------------------------------\n",
