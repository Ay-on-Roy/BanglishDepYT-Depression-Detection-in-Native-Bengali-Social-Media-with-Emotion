   "source": [
    "# CELL — Smart annotation prioritization\n",
    "# Don't annotate everything — annotate STRATEGICALLY\n",
    "# Priority: comments with emoticons + Banglish first\n",
    "# These are exactly what EPH was designed for\n",
    "\n",
    "raw_path = './BanglishDetect/data/raw/youtube_collected_raw.csv'\n",
    "df = pd.read_csv(raw_path)\n",
    "\n",
    "# Score each comment by how much it exercises EPH rules\n",
    "def eph_relevance_score(text):\n",
    "    \"\"\"Higher score = more EPH-relevant = annotate first\"\"\"\n",
    "    score = 0\n",
    "    t = str(text)\n",
    "\n",
    "    # Emoticons = +3 each (rarest, most valuable)\n",
    "    for em in EMOTICONS:\n",
    "        score += t.count(em) * 3\n",
    "\n",
    "    # Banglish tokens = +2 each\n",
    "    for tok in t.split():\n",
    "        if (re.search(r'[a-zA-Z]', tok) and\n",
    "            re.search(r'[\\u0980-\\u09FF]', tok)):\n",
    "            score += 2\n",
    "        elif re.search(r'[a-zA-Z]', tok) and len(tok) >= 3:\n",
    "            score += 1\n",
    "\n",
    "    # Elongation = +2\n",
    "    if re.search(r'(.)\\1{2,}', t):\n",
    "        score += 2\n",
    "\n",
    "    # Negation words = +1 each\n",
    "    for w in NEGATION:\n",
    "        if w in t: score += 1\n",
    "\n",
    "    # Longer comment = more context = +1\n",
    "    if len(t.split()) > 10: score += 1\n",
    "\n",
    "    return score\n",
    "NEGATION = [\n",
    "\n",
    "    \"না\",\n",
    "    \"নাই\",\n",
    "    \"নেই\",\n",
    "    \"never\",\n",
    "    \"not\",\n",
    "    \"nothing\",\n",
    "    \"none\",\n",
    "    \"nah\",\n",
    "    \"no\",\n",
    "    \"without\",\n",
    "\n",
    "]\n",
    "df['eph_score']   = df['text'].apply(eph_relevance_score)\n",
    "df['word_count']  = df['text'].apply(\n",
    "    lambda t: len(str(t).split()))\n",
    "\n",
    "# Sort by EPH relevance score — annotate highest first\n",
    "df_sorted = df.sort_values(\n",
    "    'eph_score', ascending=False\n",
    ").reset_index(drop=True)\n",
    "\n",
    "print(\"ANNOTATION PRIORITY QUEUE\")\n",
    "print(\"=\"*55)\n",
    "print(f\"Total collected: {len(df_sorted):,}\")\n",
    "print(f\"Score > 5 (high EPH):  \"\n",
    "      f\"{(df_sorted['eph_score']>5).sum():,}\")\n",
    "print(f\"Score > 2 (medium):    \"\n",
    "      f\"{(df_sorted['eph_score']>2).sum():,}\")\n",
    "print(f\"Score = 0 (no signal): \"\n",
    "      f\"{(df_sorted['eph_score']==0).sum():,}\")\n",
    "\n",
    "print(f\"\\nTop 5 most EPH-relevant comments:\")\n",
    "for i, row in df_sorted.head(5).iterrows():\n",
    "    print(f\"\\n  Score={row['eph_score']} | \"\n",
    "          f\"Label={row['tentative_label']}\")\n",
    "    print(f\"  {row['text'][:100]}\")\n",
    "\n",
    "# Target: annotate top 1000 by EPH score\n",
    "df_to_annotate = df_sorted.head(1500)\n",
    "ann_priority_path = \\\n",
    "    './BanglishDetect/data/raw/youtube_to_annotate.csv'\n",
    "df_to_annotate.to_csv(ann_priority_path, index=False)\n",
    "print(f\"\\n✅ Priority annotation queue saved\")\n",
    "print(f\"   Annotate top 1000-1500 for maximum EPH signal\")\n",
    "print(f\"   File: {ann_priority_path}\")\n",
