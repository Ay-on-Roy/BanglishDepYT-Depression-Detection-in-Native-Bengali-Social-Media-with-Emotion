    "# CELL — Complete filtering (self-contained, no external dependencies)\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import re\n",
    "import os\n",
    "\n",
    "# ── Load collected data ────────────────────────────────────\n",
    "RAW_PATH = './BanglishDetect/data/raw/youtube_collected_raw.csv'\n",
    "df = pd.read_csv(RAW_PATH)\n",
    "print(f\"Loaded: {len(df):,} comments\")\n",
    "print(f\"Columns: {df.columns.tolist()}\")\n",
    "print(f\"\\nSample:\")\n",
    "print(df.head(3)[['text','tentative_label','category']].to_string())\n",
    "\n",
    "# ── Define resources locally ───────────────────────────────\n",
    "EMOTICON_LIST = [\n",
    "    '😭','😢','😔','💔','😩','🥺','☠️','💀',\n",
    "    '😞','😟','😓','🖤','😊','😄','❤️','😂',\n",
    "    '🙏','😡','😤','🙂','😅','😫','😴',\n",
    "]\n",
    "\n",
    "NEGATION_WORDS = {'না','নেই','নয়','নি','নিই'}\n",
    "\n",
    "EMOTION_WORDS = {\n",
    "    # High depression\n",
    "    'মরতে','মরে','আত্মহত্যা','মৃত্যু','শেষ','বাঁচতে',\n",
    "    'কষ্ট','যন্ত্রণা','ব্যথা','কাঁদি','কাঁদছি','কাঁদছে',\n",
    "    'একা','নিঃসঙ্গ','অসহায়','হতাশ','নিরাশ','বিষণ্ণ',\n",
    "    'ক্লান্ত','বিধ্বস্ত','ভেঙে','ভেঙেছি',\n",
    "    # Medium depression\n",
    "    'দুঃখ','দুঃখী','খারাপ','অস্থির','চিন্তিত','ভয়','রাগ',\n",
    "    # Protective\n",
    "    'সুখী','খুশি','আনন্দ','ভালো','ভালোবাসা',\n",
    "    'আশা','স্বপ্ন','সফল','আলো','হাসি',\n",
    "}\n",
    "\n",
    "# ── Filter functions ───────────────────────────────────────\n",
    "def emoticon_spam_ratio(text):\n",
    "    \"\"\"Fraction of text that is emoji characters\"\"\"\n",
    "    t = str(text)\n",
    "    total = len(t.replace(' ',''))\n",
    "    if total == 0: return 1.0\n",
    "    emoji_chars = len(re.findall(\n",
    "        r'[\\U0001F300-\\U0001FFFF\\u2600-\\u27FF]', t))\n",
    "    return emoji_chars / total\n",
    "\n",
    "def is_repetition_spam(text):\n",
    "    \"\"\"Same short sequence repeated many times\"\"\"\n",
    "    t = str(text)\n",
    "    for length in [2, 3]:\n",
    "        for i in range(len(t)-length):\n",
    "            pattern = re.escape(t[i:i+length])\n",
    "            try:\n",
    "                if len(re.findall(pattern, t)) >= 8:\n",
    "                    return True\n",
    "            except: pass\n",
    "    return False\n",
    "\n",
    "def bengali_ratio(text):\n",
    "    t = str(text)\n",
    "    total = len(t.replace(' ',''))\n",
    "    if total == 0: return 0\n",
    "    bengali = len(re.findall(r'[\\u0980-\\u09FF]', t))\n",
    "    return bengali / total\n",
    "\n",
    "# ── Apply filters ──────────────────────────────────────────\n",
    "print(\"\\nApplying filters...\")\n",
    "\n",
    "df['emoji_ratio']   = df['text'].apply(emoticon_spam_ratio)\n",
    "df['rep_spam']      = df['text'].apply(is_repetition_spam)\n",
    "df['word_count']    = df['text'].apply(\n",
    "    lambda t: len(str(t).split()))\n",
    "df['bengali_ratio'] = df['text'].apply(bengali_ratio)\n",
    "\n",
    "# Filter conditions\n",
    "f1 = df['emoji_ratio']   <= 0.30    # not emoji spam\n",
    "f2 = ~df['rep_spam']                # not repetition spam\n",
    "f3 = df['word_count']    >= 4       # at least 4 words\n",
    "f4 = df['word_count']    <= 150     # not too long\n",
    "f5 = df['bengali_ratio'] >= 0.20    # enough Bengali\n",
    "\n",
    "# Deduplication\n",
    "df['text_norm'] = df['text'].apply(\n",
    "    lambda t: re.sub(r'\\s+', ' ', str(t).strip().lower()))\n",
    "f6 = ~df.duplicated(subset='text_norm', keep='first')\n",
    "\n",
    "# Report each filter\n",
    "print(f\"  Emoji spam (>30%):      {(~f1).sum():,} removed\")\n",
    "print(f\"  Repetition spam:        {(~f2).sum():,} removed\")\n",
    "print(f\"  Too short (<4 words):   {(~f3).sum():,} removed\")\n",
    "print(f\"  Too long (>150 words):  {(~f4).sum():,} removed\")\n",
    "print(f\"  Not Bengali (<20%):     {(~f5).sum():,} removed\")\n",
    "print(f\"  Duplicates:             {(~f6).sum():,} removed\")\n",
    "\n",
    "df_clean = df[f1&f2&f3&f4&f5&f6].copy().reset_index(drop=True)\n",
    "print(f\"\\nBefore: {len(df):,}\")\n",
    "print(f\"After:  {len(df_clean):,} \"\n",
    "      f\"({100*len(df_clean)/len(df):.1f}% kept)\")\n",
    "\n",
    "# ── EPH relevance score v2 ─────────────────────────────────\n",
    "def eph_score_v2(text, emoji_ratio):\n",
    "    t     = str(text)\n",
    "    score = 0\n",
    "\n",
    "    # Unique emoticon diversity (not raw count)\n",
    "    unique_em = sum(1 for em in EMOTICON_LIST if em in t)\n",
    "    score += unique_em * 5\n",
    "\n",
    "    # Banglish word count\n",
    "    for tok in t.split():\n",
    "        if re.search(r'[a-zA-Z]', tok) and len(tok) >= 3:\n",
    "            score += 2\n",
    "\n",
    "    # Elongation present\n",
    "    if re.search(r'(.)\\1{2,}', t):\n",
    "        score += 4\n",
    "\n",
    "    # Negation words\n",
    "    for w in NEGATION_WORDS:\n",
    "        if w in t: score += 2\n",
    "\n",
    "    # Emotion words\n",
    "    for w in EMOTION_WORDS:\n",
    "        if w in t: score += 1\n",
    "\n",
    "    # Word count bonus\n",
    "    wc = len(t.split())\n",
    "    if   wc >= 20: score += 5\n",
    "    elif wc >= 10: score += 3\n",
    "    elif wc >= 5:  score += 1\n",
    "\n",
    "    # Penalty for high emoji ratio\n",
    "    if emoji_ratio > 0.15: score -= 10\n",
    "\n",
    "    return max(0, score)\n",
    "\n",
    "print(\"\\nComputing EPH scores...\")\n",
    "df_clean['eph_score'] = df_clean.apply(\n",
    "    lambda r: eph_score_v2(r['text'], r['emoji_ratio']),\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "df_clean = df_clean.sort_values(\n",
    "    'eph_score', ascending=False\n",
    ").reset_index(drop=True)\n",
    "\n",
    "# ── Signal analysis ────────────────────────────────────────\n",
    "em_count  = sum(any(em in str(t) for em in EMOTICON_LIST)\n",
    "                for t in df_clean['text'])\n",
    "bn_count  = sum(\n",
    "    bool(re.search(r'[a-zA-Z]', str(t)) and\n",
    "         re.search(r'[\\u0980-\\u09FF]', str(t)))\n",
    "    for t in df_clean['text'])\n",
    "el_count  = sum(bool(re.search(r'(.)\\1{2,}', str(t)))\n",
    "                for t in df_clean['text'])\n",
    "neg_count = sum(any(w in str(t) for w in NEGATION_WORDS)\n",
    "                for t in df_clean['text'])\n",
    "\n",
    "n = len(df_clean)\n",
    "print(f\"\\nEMOTION SIGNALS IN CLEAN DATA:\")\n",
    "print(f\"  Emoticons:   {em_count:,} ({100*em_count/n:.1f}%)\")\n",
    "print(f\"  Banglish:    {bn_count:,} ({100*bn_count/n:.1f}%)\")\n",
    "print(f\"  Elongation:  {el_count:,} ({100*el_count/n:.1f}%)\")\n",
    "print(f\"  Negation:    {neg_count:,} ({100*neg_count/n:.1f}%)\")\n",
    "\n",
    "print(f\"\\nEPH score distribution:\")\n",
    "print(f\"  Score > 10 (high EPH):  \"\n",
    "      f\"{(df_clean['eph_score']>10).sum():,}\")\n",
    "print(f\"  Score > 5 (medium):     \"\n",
    "      f\"{(df_clean['eph_score']>5).sum():,}\")\n",
    "print(f\"  Score = 0 (no signal):  \"\n",
    "      f\"{(df_clean['eph_score']==0).sum():,}\")\n",
    "\n",
    "# ── Show top 10 after filtering ───────────────────────────\n",
    "print(f\"\\nTOP 10 QUALITY COMMENTS (after filtering):\")\n",
    "print(\"=\"*60)\n",
    "for i, row in df_clean.head(10).iterrows():\n",
    "    print(f\"\\n  Rank {i+1} | Score={row['eph_score']} | \"\n",
    "          f\"Label={row['tentative_label']} | \"\n",
    "          f\"Words={row['word_count']}\")\n",
    "    print(f\"  {str(row['text'])[:120]}\")\n",
    "\n",
    "# ── Category distribution ─────────────────────────────────\n",
    "print(f\"\\n\\nCATEGORY DISTRIBUTION (clean):\")\n",
    "print(df_clean['category'].value_counts().head(15).to_string())\n",
    "\n",
    "print(f\"\\nLABEL DISTRIBUTION:\")\n",
    "print(df_clean['tentative_label'].value_counts().to_dict())\n",
    "\n",
    "# ── Build annotation batch ─────────────────────────────────\n",
    "# Strategy: top 700 by EPH score + 300 random = 1000 total\n",
    "n_top    = min(700, len(df_clean))\n",
    "top_eph  = df_clean.head(n_top)\n",
    "rest     = df_clean.iloc[n_top:]\n",
    "n_random = min(300, len(rest))\n",
    "random_s = rest.sample(n_random, random_state=42)\n",
    "\n",
    "batch = pd.concat(\n",
    "    [top_eph, random_s], ignore_index=True\n",
    ").sample(frac=1, random_state=42).reset_index(drop=True)\n",
    "\n",
    "print(f\"\\n\\nANNOTATION BATCH:\")\n",
    "print(f\"  Total:     {len(batch):,}\")\n",
    "print(f\"  High EPH:  {n_top}\")\n",
    "print(f\"  Random:    {n_random}\")\n",
    "print(f\"  Dep (tentative):     \"\n",
    "      f\"{(batch['tentative_label']==1).sum()}\")\n",
    "print(f\"  Non-dep (tentative): \"\n",
    "      f\"{(batch['tentative_label']==0).sum()}\")\n",
    "\n",
    "# ── Save ──────────────────────────────────────────────────\n",
    "clean_path = './BanglishDetect/data/raw/youtube_clean_full.csv'\n",
    "batch_path = './BanglishDetect/data/raw/annotation_batch_final.csv'\n",
    "\n",
    "df_clean.to_csv(clean_path, index=False)\n",
    "batch[['text','tentative_label','category',\n",
    "       'eph_score','word_count','emoji_ratio']].to_csv(\n",
    "    batch_path, index=False)\n",
    "\n",
    "print(f\"\\n✅ Clean dataset saved: {clean_path}\")\n",
    "print(f\"✅ Annotation batch:    {batch_path}\")\n",
    "print(f\"\\nNEXT: Run annotation cell on annotation_batch_final.csv\")"
   ]
  },
